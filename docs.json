{
  "$schema": "https://mintlify.com/docs.json",
  "theme":   "mint",
  "name":    "PromptWall",
  "description": "AI Observability + Runtime Control. One canonical event log; multiple integration modes.",
  "colors": {
    "primary": "#3B82F6",
    "light":   "#60A5FA",
    "dark":    "#1E40AF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark":  "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Sign in",
        "href":  "https://www.prompt-wall.com/login"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab":    "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "integration-modes",
              "authentication",
              "quickstart"
            ]
          },
          {
            "group": "Integration modes",
            "pages": [
              "modes/proxy",
              "modes/verify",
              "modes/events"
            ]
          }
        ]
      },
      {
        "tab":    "API reference",
        "groups": [
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/chat-completions",
              "api-reference/verify",
              "api-reference/events"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Observability",
          "icon":   "chart-line",
          "href":   "https://www.prompt-wall.com/observability"
        },
        {
          "anchor": "GitHub",
          "icon":   "github",
          "href":   "https://github.com/Extreme421n/PromptWall-full-backup"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "x":      "https://twitter.com/promptwall",
      "github": "https://github.com/Extreme421n/PromptWall-full-backup"
    }
  }
}
