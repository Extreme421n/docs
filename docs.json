{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PromptWall",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1E40AF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/overview",
              "concepts/modes",
              "concepts/governance",
              "concepts/billing"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/python-sdk",
              "guides/node-sdk",
              "guides/webhooks",
              "guides/byok",
              "guides/verify-mode"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "api-reference/verify",
              "api-reference/chat"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "api-reference/tools-register",
              "api-reference/tools-list",
              "api-reference/tools-test"
            ]
          },
          {
            "group": "Usage & Billing",
            "pages": [
              "api-reference/usage-current",
              "api-reference/usage-timeseries"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://www.prompt-wall.com",
          "icon": "gauge"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/Extreme421n/PromptWall-full-backup",
          "icon": "github"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@prompt-wall.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Dashboard",
      "href": "https://www.prompt-wall.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Extreme421n"
    }
  },
  "api": {
    "openapi": "openapi.yaml"
  }
}
